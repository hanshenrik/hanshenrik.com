---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { orderBy } from "lodash-es";
import AudioPlayer from "../components/AudioPlayer.astro";
import Link from "../components/Link.astro";
import TopImage from "../components/TopImage.astro";
import { nav, recordings as recordingsNs } from "../i18n/ui";
import type { Lang } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import {
  APPLE_MUSIC,
  CHEVRON_DOWN,
  SOUNDCLOUD,
  SPOTIFY,
  TIDAL,
} from "../icons";
import Layout from "../layouts/Layout.astro";
import { imageToUrl } from "../utils";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = useTranslations(lang, recordingsNs);
const tNav = useTranslations(lang, nav);

const recordings = await getCollection("recordings");

const releasedRecordings = recordings.filter(
  (recording) => !recording.data.localFile,
);

const sortedReleasedRecordings = orderBy(
  releasedRecordings,
  ["data.year", "data.name"],
  "desc",
);

const localBandRecordings = recordings.filter(
  (recording) =>
    recording.data.localFile && recording.data.localFile.type === "band",
);
const sortedLocalBandRecordings = orderBy(
  localBandRecordings,
  ["data.order", "data.year", "data.name"],
  "desc",
);

const localSoloRecordings = recordings.filter(
  (recording) =>
    recording.data.localFile && recording.data.localFile.type === "solo",
);
const sortedLocalSoloRecordings = orderBy(
  localSoloRecordings,
  ["data.year", "data.name"],
  "desc",
);

const topImage = "/images/recordings.jpg";
const topImageUrl = imageToUrl(topImage);
---

<Layout title={tNav("Innspilt musikk")} image={topImageUrl}>
  <div class="mx-auto max-w-7xl space-y-8">
    <TopImage
      imageUrl={topImageUrl}
      title={tNav("Innspilt musikk")}
      alt={tNav("Innspilt musikk")}
      imageAttribution={t("Foto: Jørgen Reitan")}
    />

    <h2 class="mb-4">{t("Utgivelser")}</h2>
    <p>
      {
        t(
          "Jeg har bidratt på innspillinger med blant annet Lisa Nybrott, Kjør Romskip, Elias Eine og Reggie Got Beats. Sjekk ut spillelister på",
        )
      }
      <Link
        href="https://open.spotify.com/playlist/0HQEtUAwUe5VnLh42iIjSb?si=1234567890"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-fit items-center gap-1"
      >
        Spotify
      </Link>
      {t("eller")}
      <Link
        href="https://tidal.com/browse/playlist/0a61d353-ade3-4efe-a517-a82d99b47354"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-fit items-center gap-1"
      >
        Tidal
      </Link>.
    </p>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <div class="flex flex-col gap-2">
        <iframe
          title={t("Spotify-spilleliste")}
          class="h-[420px] rounded-none md:h-full"
          src="https://open.spotify.com/embed/playlist/0HQEtUAwUe5VnLh42iIjSb?utm_source=generator&theme=0"
          width="100%"
          height="100%"
          allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="eager"></iframe>
        <Link
          href="https://tidal.com/browse/playlist/0a61d353-ade3-4efe-a517-a82d99b47354"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-fit items-center gap-1 self-end"
        >
          {t("Også tilgjengelig på ")}<Icon name={TIDAL} />Tidal
        </Link>
      </div>
      <div
        class="grid grid-cols-2 gap-4 lg:col-span-2 lg:grid-cols-3 xl:grid-cols-4"
      >
        {
          sortedReleasedRecordings.map(({ data }) => {
            const imageUrl = data.image
              ? imageToUrl(data.image, Astro.url.origin)
              : null;
            return (
              <div class="">
                {imageUrl && (
                  <div class="relative aspect-square overflow-hidden">
                    <Image
                      src={imageUrl}
                      width={400}
                      height={400}
                      quality={100}
                      alt={`${data.artist} - ${data.name}`}
                      class="h-full w-full object-cover"
                    />
                    {data.type && (
                      <span class="absolute right-1 bottom-1 h-fit rounded-md bg-gray-100/90 px-2 py-1 text-sm shadow-inner backdrop-blur-xs">
                        {data.type}
                      </span>
                    )}
                  </div>
                )}
                <div class="py-1">
                  <h3 class="text-xl">{data.name}</h3>
                  <h4 class="font-medium">
                    {data.artist}
                    {data.year && ` (${data.year})`}
                  </h4>
                  <details>
                    <summary class="group flex w-fit list-none flex-row items-center gap-1">
                      <span class="">{t("Mer info")}</span>
                      <Icon
                        class="origin-center bg-white transition-transform group-open:scale-150 group-open:rotate-180 group-hover:scale-110 group-hover:not-group-open:rotate-6 group-hover:group-open:rotate-[174deg]"
                        name={CHEVRON_DOWN}
                        size={18}
                      />
                    </summary>
                    <div class="mt-2">
                      <div class="-ml-2 flex w-fit flex-wrap gap-0.5">
                        {data.spotifyLink && (
                          <a
                            href={data.spotifyLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            title={`${data.name} on Spotify`}
                            aria-label={`${data.name} on Spotify`}
                            class="inline-flex h-10 w-10 items-center justify-center rounded-full text-green-700 transition-colors duration-200 hover:bg-green-200"
                          >
                            <Icon name={SPOTIFY} size={24} />
                          </a>
                        )}
                        {data.tidalLink && (
                          <a
                            href={data.tidalLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            title={`${data.name} on Tidal`}
                            aria-label={`${data.name} on Tidal`}
                            class="inline-flex h-10 w-10 items-center justify-center rounded-full text-black transition-colors duration-200 hover:bg-black hover:text-white"
                          >
                            <Icon name={TIDAL} size={24} />
                          </a>
                        )}
                        {data.appleLink && (
                          <a
                            href={data.appleLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            title={`${data.name} on Apple Music`}
                            aria-label={`${data.name} on Apple Music`}
                            class="inline-flex h-10 w-10 items-center justify-center rounded-full text-pink-700 transition-colors duration-200 hover:bg-pink-200"
                          >
                            <Icon name={APPLE_MUSIC} size={24} />
                          </a>
                        )}
                        {data.soundcloudLink && (
                          <a
                            href={data.soundcloudLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            title={`${data.name} on SoundCloud`}
                            aria-label={`${data.name} on SoundCloud`}
                            class="inline-flex h-10 w-10 items-center justify-center rounded-full text-orange-700 transition-colors duration-200 hover:bg-orange-200"
                          >
                            <Icon name={SOUNDCLOUD} size={24} />
                          </a>
                        )}
                      </div>
                      <p class="text-gray-500">{data.description}</p>
                    </div>
                  </details>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
    <h2 class="mb-4">{t("Uutgitte greier")}</h2>
    <p>
      {t("Mesteparten av musikken min ligger på")}
      <Link
        href="https://soundcloud.com/hanshenrik"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-fit items-center"
      >
        SoundCloud
      </Link>{t(", men du kan også bare lytte her.")}
    </p>
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
      <AudioPlayer
        recordings={sortedLocalSoloRecordings}
        title={t("Solo")}
        playerId="solo"
        lang={lang}
      />
      <AudioPlayer
        recordings={sortedLocalBandRecordings}
        title={t("Band")}
        playerId="bands"
        lang={lang}
      />
    </div>
  </div>
</Layout>
