---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { orderBy } from "lodash-es";
import { vouchers as vervekodernNs } from "../i18n/ui";
import type { Lang } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import Layout from "../layouts/Layout.astro";
import { imageToUrl } from "../utils";

const lang = (Astro.currentLocale ?? "nb") as Lang;
const t = useTranslations(lang, vervekodernNs);

const vouchers = await getCollection("vouchers");
---

<Layout title={t("Vervekoder")}>
  <div class="mx-auto max-w-7xl space-y-6">
    <h1>{t("Vervekoder")}</h1>
    <p>{t("Her er noen tjenester jeg bruker og setter pris på.")}</p>
    <p>
      {
        t(
          "Hvis du også tenker å bruke en av de kan du (og jeg) få en ekstra liten slant hvis du registrerer deg med en av disse kodene.",
        )
      }
    </p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        orderBy(vouchers, "data.order", "asc").map((voucher) => {
          const imageUrl = voucher.data.image
            ? imageToUrl(voucher.data.image, Astro.url.origin)
            : null;

          return (
            <div class="group rounded-2xl bg-sky-50 shadow-xs">
              <div class="flex h-full flex-1 flex-col justify-between gap-3 p-6">
                <div class="flex items-center gap-4">
                  {imageUrl && (
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-xl">
                      <Image
                        src={imageUrl}
                        width={48}
                        height={48}
                        quality={100}
                        alt={voucher.data.name}
                        class="h-full w-full object-contain p-1"
                      />
                    </div>
                  )}
                  <h2 class="text-xl font-bold tracking-tight text-gray-900">
                    {voucher.data.name}
                  </h2>
                </div>

                <div class="flex flex-col gap-2">
                  {voucher.data.description && (
                    <p class="flex-1 text-sm">{voucher.data.description}</p>
                  )}
                  {voucher.data.value && (
                    <p class="flex-1 text-sm">{voucher.data.value}</p>
                  )}

                  {voucher.data.code && (
                    <div class="rounded-lg bg-white p-3 text-center">
                      <span class="block text-[10px] font-bold tracking-wider text-gray-600 uppercase">
                        {t("Vervekode")}
                      </span>
                      <code class="font-mono text-lg font-bold text-sky-600 uppercase">
                        {voucher.data.code}
                      </code>
                    </div>
                  )}
                </div>

                <a
                  href={voucher.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center gap-2 rounded-xl bg-gray-900 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-sky-600 active:scale-95"
                >
                  {t("Gå til ")}
                  {voucher.data.name}
                </a>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Layout>
