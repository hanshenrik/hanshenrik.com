---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { format } from "date-fns";
import { nb } from "date-fns/locale";
import Tag from "../../components/Tag.astro";
import { drypp as dryppNs } from "../../i18n/ui";
import type { Lang } from "../../i18n/utils";
import { useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { imageToUrl } from "../../utils";

export async function getStaticPaths() {
  const posts = await getCollection("drypp");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const lang = (Astro.currentLocale ?? "nb") as Lang;
const t = useTranslations(lang, dryppNs);

const post = Astro.props as CollectionEntry<"drypp">;
const { Content } = await render(post);

const {
  title,
  description,
  pubDate,
  updatedAt,
  image,
  imageAttribution,
  tags,
} = post.data;

const imageUrl = image ? imageToUrl(image, Astro.url.origin) : undefined;
---

<Layout
  title={title}
  image={imageUrl}
  description={description}
  showRssLink={true}
>
  <article class="mx-auto max-w-3xl pt-16 pb-24">
    <header class="mb-8">
      <h1 class="mb-4">
        {title}
      </h1>
      <p class="mb-4">{description}</p>
      {
        tags && tags.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <Tag tag={tag} />
            ))}
          </div>
        )
      }
      <div class="grid grid-cols-1">
        <time datetime={pubDate.toISOString()}>
          {t("Publisert ")}{format(pubDate, "dd.MM.yyyy", { locale: nb })}
        </time>
        {
          updatedAt && (
            <time datetime={updatedAt.toISOString()}>
              {t("Oppdatert ")}
              {format(updatedAt, "dd.MM.yyyy", { locale: nb })}
            </time>
          )
        }
      </div>
    </header>
    {
      image && (
        <figure class="relative aspect-video overflow-hidden">
          <Image
            src={imageUrl!}
            width={400}
            height={400}
            quality={100}
            alt={post.data.title}
            class="h-full w-full object-cover"
          />
          <figcaption>
            <small class="text-sm text-gray-500">{imageAttribution}</small>
          </figcaption>
        </figure>
      )
    }
    <div class="prose prose-a:no-underline">
      <Content />
    </div>
  </article>
</Layout>
